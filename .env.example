# Copy to .env and fill in. docker-compose reads this file automatically.

# ---- secrets ---------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxxxxxxxxxxxxx
POSTGRES_PASSWORD=change-me

# ---- database --------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio

# ---- public URLs -----------------------------------------------------------
# What the BROWSER uses. In production these are your real domains, e.g.
#   PUBLIC_SITE_URL=https://yourdomain.com
#   PUBLIC_API_URL=https://api.yourdomain.com
# The two must share a parent domain, or the admin session cookie is dropped.
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Hostnames, used by docker-stack.yml for the Traefik routing rules.
# Production: SITE_HOST=vbroendum.com / API_HOST=api.vbroendum.com
SITE_HOST=localhost
API_HOST=localhost

# ---- session ---------------------------------------------------------------
APP_ENV=production
SESSION_TTL=168h
# Set to true once you are serving over HTTPS.
COOKIE_SECURE=false
# Leave empty unless the API and site are on different subdomains, then use
# the shared parent with a leading dot: .yourdomain.com
COOKIE_DOMAIN=

# ---- limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# ---- host ports ------------------------------------------------------------
WEB_PORT=3000
API_PORT=8080
